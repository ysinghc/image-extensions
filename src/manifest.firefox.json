{
  "manifest_version": 3,
  "name": "ImageForge — image converter & resizer",
  "version": "1.0.0",
  "description": "Convert between PNG, JPEG, WebP, AVIF and more. Resize, crop, adjust quality, and squeeze images under a file-size limit — right from your browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "imageforge@example.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ImageForge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["contextMenus", "downloads", "storage", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
